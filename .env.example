# Copy to .env for local development and fill in real values. Never commit .env.
# On Render these are set in the service's Environment tab (see render.yaml).

# Neon pooled connection (used by the API at runtime)
DATABASE_URL=

# Neon direct (non-pooler) connection (used by drizzle-kit migrations)
DIRECT_URL=

# Secret for signing session cookies (HMAC). Generate with: openssl rand -base64 32
# MUST be identical on the Vercel project (the web app's proxy.ts verifies the same cookies).
SESSION_SECRET=

# Shared secret between the web app and this API (at least 32 characters). Generate with: openssl rand -base64 32
# MUST be identical to API_KEY on the Vercel project. Requests without it are refused.
API_KEY=

# The web app forwards the visitor's IP, authenticated by API_KEY. In production the API only trusts it when this is 1.
TRUST_PROXY_HEADERS=1

# Local port (Render sets PORT itself).
# PORT=4000

# Optional, used only by `npm run db:seed` (initial admin PIN and shop code; change after first login).
# If unset, the seed falls back to the demo values (dev only).
# SEED_ADMIN_PIN=
# SEED_SHOP_CODE=
# SEED_ENV=
